<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Voraussetzung damit wir die credentials zum DB-Server lokal speichern können-->
	  <UserSecretsId>3ce04dab-739f-4aa0-912f-10ed1fe40a44</UserSecretsId>
  </PropertyGroup>

	<ItemGroup>
		<!-- OpenAPI-Unterstützung -->
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		  <PrivateAssets>all</PrivateAssets>
		</PackageReference>

		<!-- Entity Framework Core für SQL Server -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
		<PackageReference Include="StackExchange.Redis" Version="3.2.0" />

		<!-- Sicherheitsupdate für eine transitive Abhängigkeit -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
	</ItemGroup>

</Project>
